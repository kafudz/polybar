# Maintainer: kafudz <apudmahfud@proton.me>

_pkgname=polybar
pkgname="${_pkgname}-git"
pkgver=3.7.2.r0.g272bac4
pkgrel=1
pkgdesc="A fast and easy-to-use status bar (kafudz fork)"
arch=(x86_64 aarch64)
url="https://github.com/kafudz/polybar"
license=(MIT)

depends=(
  cairo
  curl
  jsoncpp
  libmpdclient
  libnl
  libpulse
  libuv
  alsa-lib
  xcb-util
  xcb-util-cursor
  xcb-util-image
  xcb-util-renderutil
  xcb-util-wm
  xcb-util-xrm
)
makedepends=(
  cmake
  git
  i3-wm
  ninja
  pkgconf
  python
  python-packaging
  python-sphinx
)

optdepends=(
  'i3-wm: i3 module support'
  'networkmanager: NetworkManager integration for the networkmanager module'
)

provides=("${_pkgname}")
conflicts=("${_pkgname}")
backup=("etc/polybar/config.ini")

source=("${_pkgname}::git+https://github.com/kafudz/polybar.git")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}" || exit

  local ver
  # The fork has no release tags, so fall back to version.txt + commit count.
  if ! ver=$(git describe --long --tags --abbrev=7 2>/dev/null); then
    ver="$(sed -n 's/^\([0-9][0-9.]*\)$/\1/p' version.txt | head -n1)"
    ver="${ver:-0}.r$(git rev-list --count HEAD).g$(git rev-parse --short=7 HEAD)"
  fi

  printf '%s' "$ver" | sed 's/^v//; s/-/.r/; s/-/./g'
}

prepare() {
  cd "${_pkgname}" || exit
  git submodule update --init --recursive
}

build() {
  cmake \
    -S "${_pkgname}" \
    -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTS=OFF

  cmake --build build
}

check() {
  # The unit tests need googletest downloaded at configure time, so they stay
  # disabled; just verify the binaries built correctly.
  DISPLAY= ./build/bin/polybar --version
  ./build/bin/polybar-msg --help | grep -q '^Usage:'
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -Dm644 "${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
