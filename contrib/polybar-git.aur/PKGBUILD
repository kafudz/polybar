# Maintainer: kafudz <apudmahfud@proton.me>

_pkgname=polybar
pkgname="${_pkgname}-git"
pkgver=3.7.2.r0.g272bac4
pkgrel=1
pkgdesc="A fast and easy-to-use status bar (kafudz fork)"
arch=(i686 x86_64 aarch64)
url="https://github.com/kafudz/polybar"
license=(MIT)

depends=(
  cairo
  curl
  jsoncpp
  libmpdclient
  libnl
  libpulse
  libuv
  alsa-lib
  xcb-util-cursor
  xcb-util-image
  xcb-util-wm
  xcb-util-xrm
)
makedepends=(
  cmake
  git
  i3-wm
  ninja
  pkgconf
  python
  python-packaging
  python-sphinx
)

optdepends=(
  'i3-wm: i3 module support'
  'networkmanager: NetworkManager integration for the networkmanager module'
)

provides=("${_pkgname}")
conflicts=("${_pkgname}")
backup=("etc/polybar/config.ini")

source=("${_pkgname}::git+https://github.com/kafudz/polybar.git")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}" || exit
  git describe --long --tags 2>/dev/null \
    | sed 's/^.*-//; s/-/.r/; s/-/./g'
}

prepare() {
  cd "${_pkgname}" || exit
  git submodule update --init --recursive
}

build() {
  cmake \
    -S "${_pkgname}" \
    -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DPYTHON_EXECUTABLE=/usr/bin/python3 \
    -DBUILD_TESTS=OFF

  cmake --build build
}

check() {
  cmake --build build --target test
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -Dm644 "${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
